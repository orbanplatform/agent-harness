//
// Agent Harness Profile 0.1 - base Cedar schema (Cedar human-readable schema
// format, Cedar 4.x). Namespace OrbanHarness.
//
// Tool actions are per recipe. A recipe's effective schema is this file with
// one action declaration per harness.json tool inserted at the
// "@tool-actions" marker line below, in harness.json order:
//
//   action "<tool name>" appliesTo {
//     principal: [Agent],
//     resource: [Tool],
//     context: ToolContext
//   };
//
// Tool names match ^[A-Za-z0-9_-]{1,64}$ (recipes use snake_case, for
// example mail_send), so every name is a valid Cedar string literal and action
// id. policy.cedar is validated against the effective schema in strict mode;
// the conformance runner (node scripts/conformance.mjs l1 <recipe-dir>) builds
// it from harness.json before validating.
//
// Request mapping used by a runtime (and by the runner's write-gate check):
//   principal = OrbanHarness::Agent::"<harness.json agent_ref>"
//   action    = OrbanHarness::Action::"<tool name>"
//   resource  = OrbanHarness::Tool::"<tool name>"
//   context   = ToolContext, built by the runtime, never by the model.
//
// Cedar is default deny: a request is allowed only if some permit applies and
// no forbid applies. Permit patterns for write tools:
//
//   approval = always:
//     permit (principal == OrbanHarness::Agent::"<agent>",
//             action == OrbanHarness::Action::"<tool>", resource)
//     when { context.approval.granted &&
//            context.approval.enforced_identity == context.arguments_digest };
//
//   approval = over_limit (only for tools whose harness.json approval is
//   over_limit):
//     permit (principal == OrbanHarness::Agent::"<agent>",
//             action == OrbanHarness::Action::"<tool>", resource)
//     when { !context.limit_exceeded ||
//            (context.approval.granted &&
//             context.approval.enforced_identity == context.arguments_digest) };

namespace OrbanHarness {
  // A human principal: an approver, a dispatcher, or the person the agent
  // reports to. Not a principal of tool actions in 0.1; declared so that
  // deployments can attach approver and dispatcher entities.
  entity Human;

  // An agent principal. Entity id = the Agent Spec Agent component id
  // (harness.json agent_ref).
  entity Agent;

  // A tool. Entity id = the tool name in agent.json and harness.json.
  entity Tool;

  // Approval state for the call under evaluation. When no approval exists the
  // runtime sets granted = false and the two strings to "".
  type Approval = {
    // True only if a valid approve decision exists for this exact call.
    granted: Bool,
    // id of the approval request (or decision record) that granted it.
    decision_id: String,
    // enforced_identity echoed by the decision: hex SHA-256 of JCS(arguments)
    // the human approved.
    enforced_identity: String,
  };

  type ToolContext = {
    approval: Approval,
    // Hex SHA-256 of JCS(arguments) of the call under evaluation, computed by
    // the runtime.
    arguments_digest: String,
    // True when the call exceeds the tool's harness.json limit (the argument
    // named by limit.field is greater than limit.max). Computed by the
    // runtime from the call arguments; false when the tool has no limit.
    limit_exceeded: Bool,
    run_id: String,
    task_id: String,
  };

  // @tool-actions
}
